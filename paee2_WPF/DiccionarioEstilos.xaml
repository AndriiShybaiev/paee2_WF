<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reusable Palette Brushes -->
    <SolidColorBrush x:Key="fondoTitulos" Color="#2B579A" />
    <SolidColorBrush x:Key="FondoTitulosBrush" Color="#2B579A" />
    <SolidColorBrush x:Key="TextoTitulosBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextoDescriptorBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextoValorBrush" Color="#111111" />

    <!-- Section Title Style (fondoTitulos / EstiloTituloSeccion) -->
    <Style x:Key="EstiloTituloSeccion" TargetType="Label">
        <Setter Property="Background" Value="{StaticResource fondoTitulos}" />
        <Setter Property="Foreground" Value="{StaticResource TextoTitulosBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,2,6,2" />
        <Setter Property="Margin" Value="2,1,2,1" />
    </Style>

    <!-- Metric Descriptor Label Style -->
    <Style x:Key="EstiloEtiquetaDescriptor" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextoDescriptorBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,1,4,1" />
        <Setter Property="Padding" Value="4,1,4,1" />
    </Style>

    <!-- Metric Value Label Style -->
    <Style x:Key="EstiloEtiquetaValor" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextoValorBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,1,2,1" />
        <Setter Property="Padding" Value="4,1,4,1" />
    </Style>

    <!-- Action Button Style -->
    <Style x:Key="EstiloBotonAccion" TargetType="Button">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="Margin" Value="4,4,4,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</ResourceDictionary>
