<Window x:Class="paee2_WPF.VentanaAcercaDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Acerca de Monitor de Sistema"
        Height="260" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource fondoTitulos}" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="Monitor de Sistema - PAEE" 
                       Foreground="{StaticResource TextoTitulosBrush}" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Information Body -->
        <StackPanel Grid.Row="1" Margin="5,0,5,10" VerticalAlignment="Center">
            <TextBlock Text="Versión: 1.0.0" FontWeight="SemiBold" FontSize="12" Margin="0,2" />
            <TextBlock Text="Asignatura: Programación Avanzada en Entornos de Escritorio (PAEE)" FontSize="11" Margin="0,2" Foreground="{StaticResource TextoDescriptorBrush}" />
            <TextBlock Text="Sesión: Sesión 2 - Monitor de Sistema (WPF SDI)" FontSize="11" Margin="0,2" Foreground="{StaticResource TextoDescriptorBrush}" />
            <TextBlock Text="Institución: Universidad de Alicante" FontSize="11" Margin="0,2" Foreground="{StaticResource TextoDescriptorBrush}" />
        </StackPanel>

        <!-- Close Button -->
        <Button Grid.Row="2" 
                Content="Cerrar" 
                Width="100" 
                Height="28" 
                HorizontalAlignment="Center"
                IsDefault="True" 
                IsCancel="True" 
                Click="btnCerrar_Click" 
                Style="{StaticResource EstiloBotonAccion}" />
    </Grid>
</Window>
