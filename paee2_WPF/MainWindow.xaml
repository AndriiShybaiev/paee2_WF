<Window x:Class="paee2_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paee2_WPF"
        mc:Ignorable="d"
        Title="Monitor de sistema" Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <DockPanel LastChildFill="True">
        <!-- Top Toolbar / Navigation Bar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="btnNavCpuMemoria" Content="CPU y Memoria" Click="btnNavCpuMemoria_Click" Margin="2,0" />
                <Button x:Name="btnNavDiscoRed" Content="Disco y Red" Click="btnNavDiscoRed_Click" Margin="2,0" />
                <Button x:Name="btnNavSistema" Content="Sistema" Click="btnNavSistema_Click" Margin="2,0" />
                <Separator />
                <Button x:Name="btnNavAcercaDe" Content="Acerca de..." Click="btnNavAcercaDe_Click" Margin="2,0" />
                <Separator />
                <Button x:Name="btnActualizar" Content="Actualizar" Click="btnActualizar_Click" Margin="2,0" FontWeight="SemiBold" />
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content SDI Frame -->
        <Frame x:Name="mainFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" />
    </DockPanel>
</Window>
