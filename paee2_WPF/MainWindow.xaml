<Window x:Class="paee2_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paee2_WPF"
        mc:Ignorable="d"
        Title="Monitor de actividad con WPF" Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <!-- CPU -->
        <Label Grid.Row="0" Grid.Column="0" Content="CPU" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelCPU" Grid.Row="0" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Memoria -->
        <Label Grid.Row="1" Grid.Column="0" Content="Memoria" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label Grid.Row="2" Grid.Column="0" Content="Física" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelMemoriaFisica" Grid.Row="2" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="3" Grid.Column="0" Content="Virtual" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelMemoriaVirtual" Grid.Row="3" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Disco -->
        <Label Grid.Row="4" Grid.Column="0" Content="Disco" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label Grid.Row="5" Grid.Column="0" Content="Lógicos" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelDiscosLogicos" Grid.Row="5" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="6" Grid.Column="0" Content="Lectura" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelDiscoLectura" Grid.Row="6" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="7" Grid.Column="0" Content="Escritura" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelDiscoEscritura" Grid.Row="7" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="8" Grid.Column="0" Content="Lectura / Escritura" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelDiscoLecturaEscritura" Grid.Row="8" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Red -->
        <Label Grid.Row="9" Grid.Column="0" Content="Red" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label Grid.Row="10" Grid.Column="0" Content="Recibidos" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelRedRecibidos" Grid.Row="10" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="11" Grid.Column="0" Content="Enviados" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelRedEnviados" Grid.Row="11" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="12" Grid.Column="0" Content="Recibidos / Enviados" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelRedRecibidosEnviados" Grid.Row="12" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Ordenador -->
        <Label Grid.Row="13" Grid.Column="0" Content="Ordenador" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label Grid.Row="14" Grid.Column="0" Content="Fabricante" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelOrdenadorFabricante" Grid.Row="14" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="15" Grid.Column="0" Content="Modelo" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelOrdenadorModelo" Grid.Row="15" Grid.Column="1" Content="-" VerticalAlignment="Center" />
        <Label Grid.Row="16" Grid.Column="0" Content="Procesador" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelOrdenadorProcesador" Grid.Row="16" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Usuario -->
        <Label Grid.Row="17" Grid.Column="0" Content="Usuario" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Label x:Name="labelUsuario" Grid.Row="17" Grid.Column="1" Content="-" VerticalAlignment="Center" />

        <!-- Action Button -->
        <Button x:Name="btnActualizar" Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Content="Actualizar" Click="btnActualizar_Click" Margin="4,2" />
    </Grid>
</Window>
